rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validStudentProfile(uid) {
      return request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'age',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'age',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.age is int
        && request.resource.data.age > 0
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() > 0
        && request.resource.data.role == 'student'
        && request.resource.data.preferredLanguage is string
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && validStudentProfile(uid);
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'age',
          'studentCode',
          'preferredLanguage'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
  }
}
