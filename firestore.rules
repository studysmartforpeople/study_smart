rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function studentCodeCounterPath() {
      return /databases/$(database)/documents/systemCounters/studentCode;
    }

    function studentProfilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function formattedStudentCode(number) {
      return 'SDS2026-'
        + (number < 10
          ? '000' + string(number)
          : number < 100
            ? '00' + string(number)
            : number < 1000
              ? '0' + string(number)
              : string(number));
    }

    function validStudentCodeReservation() {
      return existsAfter(studentCodeCounterPath())
        && getAfter(studentCodeCounterPath()).data.lastNumber is int
        && getAfter(studentCodeCounterPath()).data.lastNumber
          == (exists(studentCodeCounterPath())
            ? get(studentCodeCounterPath()).data.lastNumber + 1
            : 1)
        && request.resource.data.studentCode
          == formattedStudentCode(
            getAfter(studentCodeCounterPath()).data.lastNumber
          );
    }

    function counterMatchesNewStudent(uid, number) {
      return !exists(studentProfilePath(uid))
        && existsAfter(studentProfilePath(uid))
        && getAfter(studentProfilePath(uid)).data.uid == uid
        && getAfter(studentProfilePath(uid)).data.role == 'student'
        && getAfter(studentProfilePath(uid)).data.studentCode
          == formattedStudentCode(number);
    }

    function validStudentProfile(uid) {
      return request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'dateOfBirth',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'dateOfBirth',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() > 0
        && request.resource.data.role == 'student'
        && request.resource.data.preferredLanguage is string
        && request.resource.data.createdAt is timestamp;
    }

    function validScore(scores, quizId) {
      return !scores.keys().hasAny([quizId])
        || (scores.get(quizId, -1) is int
          && scores.get(quizId, -1) >= 0
          && scores.get(quizId, -1) <= 100);
    }

    function validLearningProgress(data) {
      return data.keys().hasOnly([
          'bestScores',
          'passedQuizIds',
          'unlockedLessonIds',
          'credits',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'bestScores',
          'passedQuizIds',
          'unlockedLessonIds',
          'credits',
          'updatedAt'
        ])
        && data.bestScores is map
        && data.bestScores.keys().hasOnly([
          'english_alphabet_quiz',
          'english_vocabulary_quiz',
          'computer_safety_quiz',
          'math_fractions_quiz',
          'programming_variables_quiz'
        ])
        && validScore(data.bestScores, 'english_alphabet_quiz')
        && validScore(data.bestScores, 'english_vocabulary_quiz')
        && validScore(data.bestScores, 'computer_safety_quiz')
        && validScore(data.bestScores, 'math_fractions_quiz')
        && validScore(data.bestScores, 'programming_variables_quiz')
        && data.passedQuizIds is list
        && data.passedQuizIds.hasOnly([
          'english_alphabet_quiz',
          'english_vocabulary_quiz',
          'computer_safety_quiz',
          'math_fractions_quiz',
          'programming_variables_quiz'
        ])
        && data.passedQuizIds.toSet().size() == data.passedQuizIds.size()
        && data.unlockedLessonIds is list
        && data.unlockedLessonIds.hasOnly([
          'english_alphabet',
          'english_vocabulary',
          'computer_safety',
          'math_fractions',
          'programming_variables'
        ])
        && data.unlockedLessonIds.toSet().size() == data.unlockedLessonIds.size()
        && data.unlockedLessonIds.hasAny(['english_alphabet'])
        && data.credits is int
        && data.credits == data.passedQuizIds.size()
        && data.credits >= 0
        && data.credits <= 5
        && data.updatedAt is timestamp
        && (!data.passedQuizIds.hasAny(['english_alphabet_quiz'])
          || data.bestScores.get('english_alphabet_quiz', 0) >= 80)
        && (!data.passedQuizIds.hasAny(['english_vocabulary_quiz'])
          || data.bestScores.get('english_vocabulary_quiz', 0) >= 80)
        && (!data.passedQuizIds.hasAny(['computer_safety_quiz'])
          || data.bestScores.get('computer_safety_quiz', 0) >= 80)
        && (!data.passedQuizIds.hasAny(['math_fractions_quiz'])
          || data.bestScores.get('math_fractions_quiz', 0) >= 80)
        && (!data.passedQuizIds.hasAny(['programming_variables_quiz'])
          || data.bestScores.get('programming_variables_quiz', 0) >= 80)
        && (data.passedQuizIds.hasAny(['english_alphabet_quiz'])
          == data.unlockedLessonIds.hasAny(['english_vocabulary']))
        && (data.passedQuizIds.hasAny(['english_vocabulary_quiz'])
          == data.unlockedLessonIds.hasAny(['computer_safety']))
        && (data.passedQuizIds.hasAny(['computer_safety_quiz'])
          == data.unlockedLessonIds.hasAny(['math_fractions']))
        && (data.passedQuizIds.hasAny(['math_fractions_quiz'])
          == data.unlockedLessonIds.hasAny(['programming_variables']));
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && validStudentProfile(uid)
        && validStudentCodeReservation();
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'dateOfBirth',
          'preferredLanguage'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'dateOfBirth'
            ])
          || (request.resource.data.dateOfBirth is string
            && request.resource.data.dateOfBirth.matches(
              '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            )));
      allow delete: if false;

      match /learningProgress/{progressId} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isOwner(uid)
          && progressId == 'current'
          && validLearningProgress(request.resource.data);
        allow update: if isOwner(uid)
          && progressId == 'current'
          && validLearningProgress(request.resource.data)
          && request.resource.data.passedQuizIds.hasAll(resource.data.passedQuizIds)
          && request.resource.data.unlockedLessonIds.hasAll(resource.data.unlockedLessonIds)
          && request.resource.data.credits >= resource.data.credits
          && request.resource.data.bestScores.get('english_alphabet_quiz', 0)
            >= resource.data.bestScores.get('english_alphabet_quiz', 0)
          && request.resource.data.bestScores.get('english_vocabulary_quiz', 0)
            >= resource.data.bestScores.get('english_vocabulary_quiz', 0)
          && request.resource.data.bestScores.get('computer_safety_quiz', 0)
            >= resource.data.bestScores.get('computer_safety_quiz', 0)
          && request.resource.data.bestScores.get('math_fractions_quiz', 0)
            >= resource.data.bestScores.get('math_fractions_quiz', 0)
          && request.resource.data.bestScores.get('programming_variables_quiz', 0)
            >= resource.data.bestScores.get('programming_variables_quiz', 0);
        allow delete: if false;
      }

      match /profilePhotos/{photoId} {
        allow get: if isOwner(uid) && photoId == 'current';
        allow list: if false;
        allow create, update: if isOwner(uid)
          && photoId == 'current'
          && request.resource.data.keys().hasOnly(['base64'])
          && request.resource.data.keys().hasAll(['base64'])
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() > 0
          && request.resource.data.base64.size() <= 350000
          && request.resource.data.base64.matches(
            '^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$'
          );
        allow delete: if isOwner(uid) && photoId == 'current';
      }
    }

    match /systemCounters/{counterId} {
      allow get: if signedIn() && counterId == 'studentCode';
      allow list: if false;
      allow create: if signedIn()
        && counterId == 'studentCode'
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber == 1
        && counterMatchesNewStudent(request.auth.uid, 1);
      allow update: if signedIn()
        && counterId == 'studentCode'
        && resource.data.keys().hasOnly(['lastNumber'])
        && resource.data.lastNumber is int
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && counterMatchesNewStudent(
          request.auth.uid,
          request.resource.data.lastNumber
        );
      allow delete: if false;
    }
  }
}
