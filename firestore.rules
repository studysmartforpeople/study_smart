rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function studentCodeCounterPath() {
      return /databases/$(database)/documents/systemCounters/studentCode;
    }

    function studentProfilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function formattedStudentCode(number) {
      return 'SDS2026-'
        + (number < 10
          ? '000' + string(number)
          : number < 100
            ? '00' + string(number)
            : number < 1000
              ? '0' + string(number)
              : string(number));
    }

    function validStudentCodeReservation() {
      return existsAfter(studentCodeCounterPath())
        && getAfter(studentCodeCounterPath()).data.lastNumber is int
        && getAfter(studentCodeCounterPath()).data.lastNumber
          == (exists(studentCodeCounterPath())
            ? get(studentCodeCounterPath()).data.lastNumber + 1
            : 1)
        && request.resource.data.studentCode
          == formattedStudentCode(
            getAfter(studentCodeCounterPath()).data.lastNumber
          );
    }

    function counterMatchesNewStudent(uid, number) {
      return !exists(studentProfilePath(uid))
        && existsAfter(studentProfilePath(uid))
        && getAfter(studentProfilePath(uid)).data.uid == uid
        && getAfter(studentProfilePath(uid)).data.role == 'student'
        && getAfter(studentProfilePath(uid)).data.studentCode
          == formattedStudentCode(number);
    }

    function validStudentProfile(uid) {
      return request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'dateOfBirth',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'dateOfBirth',
          'studentCode',
          'role',
          'preferredLanguage',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() > 0
        && request.resource.data.role == 'student'
        && request.resource.data.preferredLanguage is string
        && request.resource.data.createdAt is timestamp;
    }


    function quizIds() {
      return [
        'english_alphabet_quiz',
        'english_vocabulary_quiz',
        'english_greetings_quiz',
        'english_pronouns_quiz',
        'english_nouns_quiz',
        'english_verbs_quiz',
        'english_adjectives_quiz',
        'english_present_simple_quiz',
        'english_question_words_quiz',
        'english_reading_quiz',
        'computer_parts_quiz',
        'computer_software_quiz',
        'computer_input_output_quiz',
        'computer_files_quiz',
        'computer_browser_quiz',
        'computer_safety_quiz',
        'computer_email_quiz',
        'computer_documents_quiz',
        'computer_networks_quiz',
        'computer_troubleshooting_quiz',
        'math_place_value_quiz',
        'math_addition_subtraction_quiz',
        'math_multiplication_quiz',
        'math_division_quiz',
        'math_fractions_quiz',
        'math_decimals_quiz',
        'math_measurement_quiz',
        'math_geometry_quiz',
        'math_patterns_quiz',
        'math_word_problems_quiz',
        'programming_algorithms_quiz',
        'programming_variables_quiz',
        'programming_data_types_quiz',
        'programming_input_output_quiz',
        'programming_operators_quiz',
        'programming_conditions_quiz',
        'programming_loops_quiz',
        'programming_functions_quiz',
        'programming_lists_quiz',
        'programming_debugging_quiz'
      ];
    }

    function lessonIds() {
      return [
        'english_alphabet',
        'english_vocabulary',
        'english_greetings',
        'english_pronouns',
        'english_nouns',
        'english_verbs',
        'english_adjectives',
        'english_present_simple',
        'english_question_words',
        'english_reading',
        'computer_parts',
        'computer_software',
        'computer_input_output',
        'computer_files',
        'computer_browser',
        'computer_safety',
        'computer_email',
        'computer_documents',
        'computer_networks',
        'computer_troubleshooting',
        'math_place_value',
        'math_addition_subtraction',
        'math_multiplication',
        'math_division',
        'math_fractions',
        'math_decimals',
        'math_measurement',
        'math_geometry',
        'math_patterns',
        'math_word_problems',
        'programming_algorithms',
        'programming_variables',
        'programming_data_types',
        'programming_input_output',
        'programming_operators',
        'programming_conditions',
        'programming_loops',
        'programming_functions',
        'programming_lists',
        'programming_debugging'
      ];
    }






    function validInitialProgressUnlocks(data) {
      return data.unlockedLessonIds.hasOnly([
          'english_alphabet',
          'computer_parts',
          'math_place_value',
          'programming_algorithms'
        ])
        && (!data.unlockedLessonIds.hasAny(['english_alphabet'])
          || data.selectedSubjectIds.hasAny(['english_basic']))
        && (!data.unlockedLessonIds.hasAny(['computer_parts'])
          || data.selectedSubjectIds.hasAny(['computer_basic']))
        && (!data.unlockedLessonIds.hasAny(['math_place_value'])
          || data.selectedSubjectIds.hasAny(['mathematics_basic']))
        && (!data.unlockedLessonIds.hasAny(['programming_algorithms'])
          || data.selectedSubjectIds.hasAny(['programming_basic']));
    }




    function nextLessonIdForQuiz(quizId) {
      return {
        'english_alphabet_quiz': 'english_vocabulary',
        'english_vocabulary_quiz': 'english_greetings',
        'english_greetings_quiz': 'english_pronouns',
        'english_pronouns_quiz': 'english_nouns',
        'english_nouns_quiz': 'english_verbs',
        'english_verbs_quiz': 'english_adjectives',
        'english_adjectives_quiz': 'english_present_simple',
        'english_present_simple_quiz': 'english_question_words',
        'english_question_words_quiz': 'english_reading',
        'computer_parts_quiz': 'computer_software',
        'computer_software_quiz': 'computer_input_output',
        'computer_input_output_quiz': 'computer_files',
        'computer_files_quiz': 'computer_browser',
        'computer_browser_quiz': 'computer_safety',
        'computer_safety_quiz': 'computer_email',
        'computer_email_quiz': 'computer_documents',
        'computer_documents_quiz': 'computer_networks',
        'computer_networks_quiz': 'computer_troubleshooting',
        'math_place_value_quiz': 'math_addition_subtraction',
        'math_addition_subtraction_quiz': 'math_multiplication',
        'math_multiplication_quiz': 'math_division',
        'math_division_quiz': 'math_fractions',
        'math_fractions_quiz': 'math_decimals',
        'math_decimals_quiz': 'math_measurement',
        'math_measurement_quiz': 'math_geometry',
        'math_geometry_quiz': 'math_patterns',
        'math_patterns_quiz': 'math_word_problems',
        'programming_algorithms_quiz': 'programming_variables',
        'programming_variables_quiz': 'programming_data_types',
        'programming_data_types_quiz': 'programming_input_output',
        'programming_input_output_quiz': 'programming_operators',
        'programming_operators_quiz': 'programming_conditions',
        'programming_conditions_quiz': 'programming_loops',
        'programming_loops_quiz': 'programming_functions',
        'programming_functions_quiz': 'programming_lists',
        'programming_lists_quiz': 'programming_debugging'
      }.get(quizId, null);
    }

    function validQuizUnlockUpdate(data) {
      let quizId = data.get('lastQuizId', null);
      let nextLessonId = nextLessonIdForQuiz(quizId);
      return quizId == null
        ? data.unlockedLessonIds.size()
          <= resource.data.unlockedLessonIds.size() + 1
        : nextLessonId == null
        ? data.unlockedLessonIds.size()
          == resource.data.unlockedLessonIds.size()
        : data.unlockedLessonIds.size()
            <= resource.data.unlockedLessonIds.size() + 1
          && data.unlockedLessonIds.hasAny([nextLessonId]);
    }

    function validProgressUnlockUpdate(data) {
      return data.diff(resource.data).affectedKeys().hasAny(['passedQuizIds'])
        ? validQuizUnlockUpdate(data)
        : validSubjectUnlockUpdate(data);
    }

    function validSubjectUnlockUpdate(data) {
      let allowedUnlocks = resource.data.unlockedLessonIds.concat([
        data.selectedSubjectIds.hasAny(['english_basic'])
          ? 'english_alphabet'
          : '',
        data.selectedSubjectIds.hasAny(['computer_basic'])
          ? 'computer_parts'
          : '',
        data.selectedSubjectIds.hasAny(['mathematics_basic'])
          ? 'math_place_value'
          : '',
        data.selectedSubjectIds.hasAny(['programming_basic'])
          ? 'programming_algorithms'
          : ''
      ]);
      return data.unlockedLessonIds.hasOnly(allowedUnlocks);
    }

    function validScoreValue(score) {
      return score is int && score >= 0 && score <= 100;
    }


    function validScoreTransitionById(data, oldData) {
      let changedScores = data.bestScores.diff(oldData.bestScores).affectedKeys();
      let newPasses = data.passedQuizIds.toSet()
        .difference(oldData.passedQuizIds.toSet());
      let quizId = data.get('lastQuizId', null);
      return quizId == null
        ? changedScores.size() == 0 && newPasses.size() == 0
        : newPasses.size() <= 1
          && changedScores.size() <= 1
          && changedScores.hasOnly([quizId])
          && newPasses.hasOnly([quizId])
          && changedScores.hasAll(newPasses)
          && (changedScores.size() == 0
            || (validScoreValue(data.bestScores.get(quizId, -1))
              && data.bestScores.get(quizId, -1)
                >= oldData.bestScores.get(quizId, 0)))
          && (newPasses.size() == 0
            || data.bestScores.get(quizId, 0) >= 80);
    }


    function validLearningProgress(data) {
      return data.keys().hasOnly([
          'bestScores',
          'passedQuizIds',
          'unlockedLessonIds',
          'selectedSubjectIds',
          'lastQuizId',
          'credits',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'bestScores',
          'passedQuizIds',
          'unlockedLessonIds',
          'selectedSubjectIds',
          'credits',
          'updatedAt'
        ])
        && data.bestScores is map
        && data.passedQuizIds is list
        && data.passedQuizIds.toSet().size() == data.passedQuizIds.size()
        && data.unlockedLessonIds is list
        && data.unlockedLessonIds.hasOnly(lessonIds())
        && data.unlockedLessonIds.toSet().size() == data.unlockedLessonIds.size()
        && data.selectedSubjectIds is list
        && data.selectedSubjectIds.hasOnly([
          'english_basic',
          'computer_basic',
          'mathematics_basic',
          'programming_basic'
        ])
        && data.selectedSubjectIds.toSet().size() == data.selectedSubjectIds.size()
        && (!data.keys().hasAny(['lastQuizId'])
          || data.lastQuizId == null
          || quizIds().hasAny([data.lastQuizId]))
        && data.credits is int
        && data.credits == data.passedQuizIds.size()
        && data.credits >= 0
        && data.credits <= 40
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && validStudentProfile(uid)
        && validStudentCodeReservation();
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'dateOfBirth',
          'preferredLanguage'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'dateOfBirth'
            ])
          || (request.resource.data.dateOfBirth is string
            && request.resource.data.dateOfBirth.matches(
              '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            )));
      allow delete: if false;

      match /learningProgress/{progressId} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isOwner(uid)
          && progressId == 'current'
          && validLearningProgress(request.resource.data)
          && request.resource.data.bestScores.size() == 0
          && request.resource.data.passedQuizIds.size() == 0
          && request.resource.data.get('lastQuizId', null) == null
          && validInitialProgressUnlocks(request.resource.data);
        allow update: if isOwner(uid)
          && progressId == 'current'
          && validLearningProgress(request.resource.data)
          && validProgressUnlockUpdate(request.resource.data)
          && request.resource.data.passedQuizIds.hasAll(resource.data.passedQuizIds)
          && request.resource.data.unlockedLessonIds.hasAll(resource.data.unlockedLessonIds)
          && request.resource.data.credits >= resource.data.credits
          && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['bestScores', 'passedQuizIds'])
            || validScoreTransitionById(request.resource.data, resource.data));
        allow delete: if false;
      }

      match /profilePhotos/{photoId} {
        allow get: if isOwner(uid) && photoId == 'current';
        allow list: if false;
        allow create, update: if isOwner(uid)
          && photoId == 'current'
          && request.resource.data.keys().hasOnly(['base64'])
          && request.resource.data.keys().hasAll(['base64'])
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() > 0
          && request.resource.data.base64.size() <= 350000
          && request.resource.data.base64.matches(
            '^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$'
          );
        allow delete: if isOwner(uid) && photoId == 'current';
      }
    }

    match /systemCounters/{counterId} {
      allow get: if signedIn() && counterId == 'studentCode';
      allow list: if false;
      allow create: if signedIn()
        && counterId == 'studentCode'
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber == 1
        && counterMatchesNewStudent(request.auth.uid, 1);
      allow update: if signedIn()
        && counterId == 'studentCode'
        && resource.data.keys().hasOnly(['lastNumber'])
        && resource.data.lastNumber is int
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && counterMatchesNewStudent(
          request.auth.uid,
          request.resource.data.lastNumber
        );
      allow delete: if false;
    }
  }
}
